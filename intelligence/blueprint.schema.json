{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Editing Blueprint v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "brand_id": {
      "type": "string",
      "minLength": 1
    },
    "topic_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_video_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "target_platform": {
      "enum": [
        "xiaohongshu",
        "instagram",
        "tiktok",
        "youtube"
      ]
    },
    "aspect_ratio": {
      "enum": [
        "9:16",
        "16:9",
        "1:1",
        "4:5"
      ]
    },
    "resolution": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "target_duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "start_time": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "source_in": {
            "type": "number",
            "minimum": 0
          },
          "source_out": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "crop_mode": {
            "enum": [
              "contain",
              "cover"
            ]
          },
          "focal_point": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "text_overlay": {
            "type": "string"
          },
          "font_style": {
            "type": "string",
            "minLength": 1
          },
          "text_position": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "animation": {
            "enum": [
              "none",
              "fade"
            ]
          },
          "transition": {
            "enum": [
              "cut",
              "fade"
            ]
          },
          "narration": {
            "type": "string"
          },
          "audio_cue": {
            "type": "string"
          },
          "creative_purpose": {
            "type": "string",
            "minLength": 1
          },
          "is_illustration": {
            "type": "boolean"
          }
        },
        "required": [
          "scene_id",
          "start_time",
          "duration",
          "asset_id",
          "source_in",
          "source_out",
          "crop_mode",
          "focal_point",
          "text_overlay",
          "font_style",
          "text_position",
          "animation",
          "transition",
          "narration",
          "audio_cue",
          "creative_purpose",
          "is_illustration"
        ],
        "additionalProperties": false
      }
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_time": {
            "type": "number",
            "minimum": 0
          },
          "end_time": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "font_style": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "start_time",
          "end_time",
          "text",
          "font_style",
          "position"
        ],
        "additionalProperties": false
      }
    },
    "typography": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "size_ratio": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "stroke_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "stroke_width": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "family",
          "size_ratio",
          "color",
          "stroke_color",
          "stroke_width"
        ],
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "after_scene_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "cut",
              "fade"
            ]
          },
          "duration": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "after_scene_id",
          "type",
          "duration"
        ],
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "start_time": {
            "type": "number",
            "minimum": 0
          },
          "source_in": {
            "type": "number",
            "minimum": 0
          },
          "source_out": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        },
        "required": [
          "asset_id",
          "start_time",
          "source_in",
          "source_out",
          "volume"
        ],
        "additionalProperties": false
      }
    },
    "brand_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "asset_id",
          "position"
        ],
        "additionalProperties": false
      }
    },
    "output_settings": {
      "type": "object",
      "properties": {
        "container": {
          "const": "mp4"
        },
        "video_codec": {
          "const": "h264"
        },
        "fps": {
          "enum": [
            24,
            25,
            30,
            60
          ]
        },
        "audio_codec": {
          "const": "aac"
        }
      },
      "required": [
        "container",
        "video_codec",
        "fps",
        "audio_codec"
      ],
      "additionalProperties": false
    },
    "approval_status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "missing_materials": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "brand_id",
    "topic_id",
    "reference_video_ids",
    "asset_ids",
    "target_platform",
    "aspect_ratio",
    "resolution",
    "target_duration",
    "language",
    "scenes",
    "subtitles",
    "typography",
    "transitions",
    "audio",
    "brand_elements",
    "output_settings",
    "approval_status",
    "missing_materials"
  ],
  "additionalProperties": false
}
